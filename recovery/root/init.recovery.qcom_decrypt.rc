# Samsung M55 secure-stack startup for recovery.
# qseecomd must be running before the QTEE/QSEE HIDL services register.
service qseecomd /system/bin/qseecomd
    class core
    disabled
    user root
    group root system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    seclabel u:r:recovery:s0

service m55-secure-stack-init /system/bin/sh /system/bin/m55-secure-stack-init.sh
    class core
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

on property:ro.crypto.state=encrypted && property:hwservicemanager.ready=true
    start m55-secure-stack-init
