# Galaxy M55: Samsung Hermes implements stock HIDL Weaver 1.0.
# Experimental first validation is MANUAL (adb shell setprop ctl.start hermesd).
# TWRP sets crypto.ready before DE keys have finished installing.
# Do not auto-start it before /data/vendor/gatekeeper is accessible.
service hermesd /vendor/bin/hermesd /data/vendor/gatekeeper
    class hal
    disabled
    user system
    group system 5678
    socket hermes_secnvm stream 660 system system
    capabilities WAKE_ALARM
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    seclabel u:r:recovery:s0
