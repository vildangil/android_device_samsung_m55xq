# Samsung M55 secure-stack startup.
# Keep this separate from qcom_decrypt.rc: the common file also defines
# Gatekeeper/Keymaster services needed by recovery's FBE implementation.
service m55-secure-stack-init /system/bin/sh /system/bin/m55-secure-stack-init.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

# On Samsung M55 recovery ro.crypto.state is absent until decryption runs.
# That made this action impossible to fire and left all secure services
# undefined/stopped while Process_Fstab waited 75 seconds. Wait instead for
# hwservicemanager and the dynamic vendor block mapper to become ready.
on property:hwservicemanager.ready=true && property:twrp.super.symlinks_created=true
    start m55-secure-stack-init
