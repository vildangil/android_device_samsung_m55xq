import /init.recovery.qcom_decrypt.rc
import /init.recovery.samsung.rc

on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.controller a600000.dwc3
    setprop prepdecrypt.setpatch true
    setprop prepdecrypt.loglevel 2
    setprop logd.ready true
    # Stock metadata key was created on Android 16 / 2025-12-01.
    # The TWRP 12.1 ramdisk otherwise advertises Android 12 and 2099 SPL.
    # KeyMint starts during 'on boot', before prepdecrypt fixes these values.
    # Align the live props here, before KeyMint can deserialize the key.
    # resetprop is provided by TW_INCLUDE_LIBRESETPROP.
    exec -- /system/bin/resetprop ro.build.version.release 16
    exec -- /system/bin/resetprop ro.build.version.security_patch 2025-12-01
    exec -- /system/bin/resetprop ro.vendor.build.security_patch 2025-12-01
    start health-hal-2-1

on boot 
    start health-hal-2-1
    start vendor.keymint-default

on property:ro.boot.usbcontroller=*
#    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    mkdir /vendor/firmware_mnt
    mount vfat /dev/block/bootdevice/by-name/apnhlos /vendor/firmware_mnt
    # Samsung KeyMint reads /mnt/vendor/efs/DAK and prov_data at startup.
    # EFS was not mounted at this location; an empty directory is not enough.
    # Read-only: never modify EFS keys or provisioning during recovery startup.
    mkdir /mnt/vendor/efs 0771 root root
    mount ext4 /dev/block/bootdevice/by-name/efs /mnt/vendor/efs ro

    export ANDROID_ROOT /system_root
    
on post-fs-data
    mkdir /data/vendor/keymaster 0775 root root

service vendor.keymint-default /system/bin/android.hardware.security.keymint-service
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    user root
    group root drmrpc
    seclabel u:r:recovery:s0
