import /init.recovery.qcom_decrypt.rc
import /init.recovery.samsung.rc

on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.controller a600000.dwc3
    setprop prepdecrypt.setpatch true
    setprop prepdecrypt.loglevel 2
    setprop logd.ready true
    # Do NOT hardcode a security patch here. Different M55/F55 ROMs
    # can have different SPLs even with the same recovery image.
    # The separate nonblocking twrp-keymint-spl service waits for the
    # dynamic super mappings, reads stock system/vendor build.prop
    # read-only, and starts KeyMint after configuring those properties.
    # Platform release is set to Android 16 for the initial recovery UI.
    exec u:r:recovery:s0 root root -- /system/bin/resetprop ro.build.version.release 16
    start health-hal-2-1

on boot
    start health-hal-2-1
    # KeyMint must not start until real system/vendor SPLs have been
    # detected. If detection fails, the worker starts baseline KeyMint
    # rather than leaving decryption services permanently unavailable.
    start twrp-keymint-spl

    # Galaxy M55 battery/charger power_supply devices are registered only
    # after ADSP (remoteproc0) boots and PMIC GLINK connects.
    # Verified on hardware: echo start > /sys/class/remoteproc/remoteproc0/state
    # changes offline -> running and exposes battery/ac/usb/wireless.
    # Firmware partition is mounted earlier in on fs. Do not start the other
    # remoteprocs; keep the existing KeyMint/FBE startup sequence unchanged.
    wait /sys/class/remoteproc/remoteproc0/state 2
    write /sys/class/remoteproc/remoteproc0/state start

on property:ro.boot.usbcontroller=*
#    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    mkdir /vendor/firmware_mnt
    mount vfat /dev/block/bootdevice/by-name/apnhlos /vendor/firmware_mnt
    # Samsung KeyMint reads /mnt/vendor/efs/DAK and prov_data at startup.
    # EFS was not mounted at this location; an empty directory is not enough.
    # Read-only: never modify EFS keys or provisioning during recovery startup.
    mkdir /mnt/vendor/efs 0771 root root
    mount ext4 /dev/block/bootdevice/by-name/efs /mnt/vendor/efs ro

    export ANDROID_ROOT /system_root
    
on post-fs-data
    mkdir /data/vendor/keymaster 0775 root root

# The SPL worker is the only permitted starter of KeyMint in this
# experimental branch. Otherwise class_start default may auto-run the
# service with the TWRP build-time December 2025 patch levels.
service vendor.keymint-default /system/bin/android.hardware.security.keymint-service
    class hal
    disabled
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    user root
    group root drmrpc
    seclabel u:r:recovery:s0

# Experimental auto-SPL detector. Runs concurrently with the TWRP UI,
# which creates dm system/vendor nodes. Does NOT access encrypted data.
service twrp-keymint-spl /system/bin/sh /system/bin/twrp-keymint-spl.sh
    class hal
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
